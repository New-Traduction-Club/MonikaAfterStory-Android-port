<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWindowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/setupTitlebar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/colorTaskbarBackground"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnLanguage"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <LinearLayout
                android:id="@+id/btnLanguage"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvCurrentLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="English"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/colorIconTint"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorDivider" />

        <ScrollView
            android:id="@+id/setupContentScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="@color/colorWindowBackground"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:orientation="vertical"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_description"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_ddlc_sha256"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:background="@color/colorSurfaceVariant"
                        android:textColor="@color/colorTextSecondary"
                        android:padding="10dp"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:id="@+id/layoutProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/colorSurfaceVariant"
                        android:padding="12dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Installing..."
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <ProgressBar
                            android:id="@+id/progressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progressTint="@color/colorPrimary"
                            android:indeterminate="true" />
                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorDivider"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/colorCardBackground"
                        app:contentPadding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_step_1_title"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_step_1_desc"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                android:layout_marginBottom="10dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btnDownloadDDLC"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:text="@string/setup_btn_download"
                                    android:textSize="12sp"
                                    android:paddingHorizontal="4dp"
                                    android:layout_marginEnd="8dp" />

                                <Button
                                    android:id="@+id/btnSelectDDLC"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:text="@string/setup_btn_select_file"
                                    android:textSize="12sp"
                                    android:paddingHorizontal="4dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvSelectedDDLC"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#4CAF50"
                                android:textStyle="italic"
                                android:textSize="12sp"
                                android:layout_marginTop="6dp"
                                android:visibility="gone"
                                tools:visibility="visible"
                                tools:text="Selected: ddlc-win.zip" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/colorCardBackground"
                        app:contentPadding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_step_2_title"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_step_2_desc"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                android:layout_marginBottom="10dp" />

                            <Button
                                android:id="@+id/btnAutoDownloadMAS"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:text="@string/setup_btn_download_auto"
                                android:textSize="12sp"
                                style="@style/Widget.Material3.Button.OutlinedButton" />

                            <TextView
                                android:id="@+id/tvSelectedMAS"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#4CAF50"
                                android:textStyle="italic"
                                android:textSize="12sp"
                                android:layout_marginTop="6dp"
                                android:visibility="gone"
                                tools:visibility="visible"
                                tools:text="Selected: mas-mod.zip" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <Button
                        android:id="@+id/btnInstall"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/setup_btn_continue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/colorPrimary"
                        android:textColor="@color/colorOnPrimary" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/notificationPermissionScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorWindowBackground"
            app:cardCornerRadius="8dp"
            app:cardElevation="16dp"
            app:contentPadding="22dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:id="@+id/ivNotificationPermissionIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/colorPrimary"
                        android:layout_marginEnd="16dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNotificationPermissionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_notifications_title"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNotificationPermissionDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/setup_notifications_description"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnGrantNotificationPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_notifications_allow"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvNotificationPermissionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/setup_notifications_enabled"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider"
                    android:layout_marginVertical="16dp" />

                <LinearLayout
                    android:id="@+id/notificationPermissionBottomActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSkipNotificationPermission"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/setup_notifications_skip"
                        android:textSize="13sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnContinueAfterNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:enabled="false"
                        android:text="@string/setup_notifications_continue"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
